<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="VolunteerConnect2.Views.MyRegistrationPage"
    Title="My Registrations">

    <VerticalStackLayout Padding="15" Spacing="15">

        <CollectionView x:Name="RegistrationsList"
                        SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="#cccccc" CornerRadius="10" Padding="10" Margin="5">
                        <VerticalStackLayout Spacing="5">

                            <Label Text="{Binding OpportunityTitle}"
                                   FontSize="18"
                                   FontAttributes="Bold" />

                            <Label Text="{Binding RegistrationDate, StringFormat='Registered: {0:dd MMM yyyy}'}"
                                   FontSize="14"
                                   TextColor="Gray" />

                            <Label Text="{Binding ContactDetail}"
                                   FontSize="14"
                                   TextColor="Gray" />

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
