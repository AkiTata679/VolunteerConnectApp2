<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="VolunteerConnect2.Views.OpportunityDetailsPage"
    Title="Opportunity Details">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Image -->
            <Image x:Name="OpportunityImage"
                   HeightRequest="200"
                   Aspect="AspectFill" />

            <!-- Title -->
            <Label x:Name="TitleLabel"
                   FontSize="26"
                   FontAttributes="Bold" />

            <!-- Category -->
            <Label x:Name="CategoryLabel"
                   FontSize="18"
                   TextColor="Gray" />

            <!-- Date -->
            <Label x:Name="DateLabel"
                   FontSize="16"
                   TextColor="Gray" />

            <!-- Time -->
            <Label x:Name="TimeLabel"
                   FontSize="16"
                   TextColor="Gray" />

            <!-- Location -->
            <Label x:Name="LocationLabel"
                   FontSize="16"
                   TextColor="Gray" />

            <!-- Description -->
            <Label Text="Description"
                   FontSize="20"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <Label x:Name="DescriptionLabel"
                   FontSize="16" />

            <!-- Requirements -->
            <Label Text="Requirements"
                   FontSize="20"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <Label x:Name="RequirementsLabel"
                   FontSize="16" />

            <!-- Available Places -->
            <Label x:Name="PlacesLabel"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="Purple" />

            <!-- Register Button -->
            <Button Text="Register Interest"
                    x:Name="RegisterButton"
                    BackgroundColor="#0078D4"
                    TextColor="White"
                    FontSize="18"
                    CornerRadius="10" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
