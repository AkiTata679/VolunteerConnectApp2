<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="VolunteerConnect2.Views.RegistrationPage"
    Title="Register Interest">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Opportunity Title -->
            <Label x:Name="OpportunityTitleLabel"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <!-- Preferred Name -->
            <Label Text="Preferred Name" FontSize="18" />
            <Entry x:Name="PreferredNameEntry"
                   Placeholder="Enter your preferred name" />

            <!-- Contact Detail -->
            <Label Text="Email Address or Phone Number" FontSize="18" />
            <Entry x:Name="ContactEntry"
                   Placeholder="Enter email or phone number" />

            <!-- Availability -->
            <Label Text="Availability" FontSize="18" />
            <Entry x:Name="AvailabilityEntry"
                   Placeholder="When are you available?" />

            <!-- Optional Note -->
            <Label Text="Optional Note" FontSize="18" />
            <Editor x:Name="NotesEditor"
                    Placeholder="Add a note (optional)"
                    AutoSize="TextChanges" />

            <!-- Privacy Consent -->
            <HorizontalStackLayout Spacing="10">
                <CheckBox x:Name="PrivacyConsentCheckBox" />
                <Label Text="I consent to my information being stored for volunteer registration purposes."
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Submit Button -->
            <Button Text="Submit Registration"
                    BackgroundColor="#0078D4"
                    TextColor="White"
                    CornerRadius="10"
                    Clicked="SubmitClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
