<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="VolunteerConnect2.Views.HomePage"
    Title="VolunteerConnect">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <Label Text="VolunteerConnect"
                   FontSize="32"
                   HorizontalOptions="Center"
                   FontAttributes="Bold" />

            <Label Text="Discover local volunteer opportunities and manage your registrations."
                   FontSize="16"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <!-- Featured Opportunity -->
            <Frame BorderColor="#cccccc" CornerRadius="12" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Featured Opportunity"
                           FontSize="20"
                           FontAttributes="Bold" />

                    <Image x:Name="FeaturedImage"
                           HeightRequest="160"
                           Aspect="AspectFill"
                           StrokeShape="RoundRectangle 12" />

                    <Label x:Name="FeaturedTitle"
                           FontSize="18"
                           FontAttributes="Bold" />

                    <Label x:Name="FeaturedCategory"
                           FontSize="14"
                           TextColor="Gray" />

                    <Label x:Name="FeaturedDate"
                           FontSize="14"
                           TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>

            <!-- Navigation Buttons -->
            <Button Text="Browse Opportunities"
                    x:Name="BrowseButton"
                    FontSize="18"
                    BackgroundColor="#0078D4"
                    TextColor="White"
                    CornerRadius="10" />

            <Button Text="My Registrations"
                    x:Name="RegistrationsButton"
                    FontSize="18"
                    BackgroundColor="#444"
                    TextColor="White"
                    CornerRadius="10" />

            <Button Text="Privacy Information"
                    x:Name="PrivacyButton"
                    FontSize="18"
                    BackgroundColor="#888"
                    TextColor="White"
                    CornerRadius="10" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
