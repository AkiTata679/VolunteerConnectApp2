<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="VolunteerConnect2.Views.PrivacyPage"
    Title="Privacy Information">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Privacy Information"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="Your privacy is important. This app stores your registration details locally on your device. No information is shared externally or uploaded anywhere."
                   FontSize="16"
                   TextColor="Gray"
                   LineBreakMode="WordWrap" />

            <Label Text="Information Stored"
                   FontSize="20"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <Label Text="• Preferred name\n• Contact details\n• Availability\n• Notes (optional)\n• Consent confirmation\n• Registration date"
                   FontSize="16"
                   LineBreakMode="WordWrap" />

            <Label Text="You may delete your registrations at any time from the My Registrations page."
                   FontSize="16"
                   TextColor="Gray"
                   LineBreakMode="WordWrap" />

            <Button Text="Clear My Messages"
                    x:Name="ClearMessagesButton"
                    BackgroundColor="#888"
                    TextColor="White"
                    FontSize="18"
                    CornerRadius="10" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
