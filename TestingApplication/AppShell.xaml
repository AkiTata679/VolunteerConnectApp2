<?xml version="1.0" encoding="UTF-8" ?>
<Shell 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:VolunteerConnect2.Views"
    x:Class="VolunteerConnect2.AppShell">

    <!-- Home Page -->
    <ShellContent
        Title="Home"
        Route="HomePage"
        ContentTemplate="{DataTemplate views:HomePage}" />

    <!-- Opportunities -->
    <ShellContent
        Title="Opportunities"
        Route="OpportunitiesPage"
        ContentTemplate="{DataTemplate views:OpportunitiesPage}" />

    <!-- Registrations -->
    <ShellContent
        Title="My Registrations"
        Route="MyRegistrationPage"
        ContentTemplate="{DataTemplate views:MyRegistrationPage}" />

    <!-- Privacy -->
    <ShellContent
        Title="Privacy"
        Route="PrivacyPage"
        ContentTemplate="{DataTemplate views:PrivacyPage}" />

</Shell>
